# ── Neuro-Gen — Variáveis de ambiente
# Copie para .env e preencha antes de rodar docker-compose.full.yml

# Obrigatório: chave AES-256 hex 64 chars
# Linux/Mac: openssl rand -hex 32
# Windows PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
SENSITIVE_DATA_KEY=

# Senha do pgAdmin (opcional — padrão: admin)
PGADMIN_PASSWORD=admin

# Tamanho do pool de conexões (opcional — padrão: 10)
DB_POOL_SIZE=10
